# ---------------------------------------------------------------------------
# Voices – environment variable template
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local or any file containing real keys.
# ---------------------------------------------------------------------------

# Supabase (auto-injected in Edge Functions; needed for local dev with supabase CLI)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to clients

# Deepgram — used by supabase/functions/transcribe-clip
# Get your key at https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# OpenAI — used by supabase/functions/transcribe-clip
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
